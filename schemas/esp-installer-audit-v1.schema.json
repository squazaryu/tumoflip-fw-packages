{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/squazaryu/tumoflip-fw-packages/schemas/esp-installer-audit-v1.schema.json",
  "title": "ESP installer manifest audit contract",
  "type": "object",
  "required": ["schema", "kind", "repository", "selection", "profiles", "hardwareEvidence"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "espInstallerAudit"},
    "repository": {"const": "justcallmekoko/ESP32Marauder"},
    "selection": {
      "type": "object",
      "required": ["releasePattern", "includePrereleases"],
      "properties": {
        "releasePattern": {"const": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "includePrereleases": {"const": false}
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["board", "recipe", "status", "roles", "offsets", "sizes"],
        "properties": {
          "board": {"type": "string", "minLength": 1},
          "recipe": {"type": "string", "minLength": 1},
          "status": {"enum": ["needsReview", "accepted", "rejected"]},
          "roles": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"enum": ["bootloader", "partition-table", "ota-data", "application"]}},
          "offsets": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
          "sizes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "hardwareEvidence": {
      "type": "object",
      "required": ["minimumPerBoard", "requiredChecks"],
      "properties": {
        "minimumPerBoard": {"const": true},
        "requiredChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
