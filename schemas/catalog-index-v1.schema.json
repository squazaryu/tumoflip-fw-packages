{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/squazaryu/tumoflip-fw-packages/schemas/catalog-index-v1.schema.json",
  "title": "Tumoflip FW Packages catalog index",
  "type": "object",
  "required": ["schema", "repository", "generated_at", "selection_policy", "channels"],
  "properties": {
    "schema": {"const": 1},
    "repository": {"type": "string", "const": "squazaryu/tumoflip-fw-packages"},
    "generated_at": {"type": "string", "minLength": 1},
    "selection_policy": {
      "type": "object",
      "required": ["auto", "manual", "withdrawal"],
      "properties": {
        "auto": {"const": "highest compatible active revision"},
        "manual": {"const": "any compatible active or legacy revision"},
        "withdrawal": {"const": "immutable release retained; index state becomes withdrawn"}
      },
      "additionalProperties": false
    },
    "channels": {
      "type": "object",
      "required": ["stable", "dev"],
      "properties": {
        "stable": {"$ref": "#/$defs/channel"},
        "dev": {"$ref": "#/$defs/channel"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["current_revision", "releases"],
      "properties": {
        "current_revision": {"type": "integer", "minimum": 1},
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/release"}
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "revision", "tag", "repository", "release_id", "manifest_sha256",
        "archive_sha256", "state", "compatibility"
      ],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "tag": {"type": "string", "pattern": "^fw-packages-(stable|dev)-[0-9]{3}$"},
        "repository": {"type": "string", "minLength": 1},
        "release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "published_at": {"type": "string"},
        "state": {"enum": ["active", "legacy", "withdrawn"]},
        "compatibility": {
          "type": "object",
          "required": ["targets", "api_majors"],
          "properties": {
            "targets": {"type": "array", "items": {"type": "integer", "minimum": 1}},
            "api_majors": {"type": "array", "items": {"type": "integer", "minimum": 1}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
